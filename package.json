{
  "name": "mcplock",
  "version": "0.1.2",
  "description": "Lockfiles for MCP tool surfaces.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhasouris/mcplock.git"
  },
  "type": "module",
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run --coverage"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "yaml": "^2.5.0",
    "zod": "^4.4.3"
  },
  "pnpm": {
    "overrides": {
      "vite": ">=6.4.3 <7"
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^20.16.0",
    "@vitest/coverage-v8": "^3.2.6",
    "esbuild": "^0.25.12",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.3.0",
    "tsup": "^8.3.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^3.2.6"
  }
}
